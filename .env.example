# --- apikey.fan provider (Grok image & video generation) ---
# Leave APIKEY_FAN_API_KEY empty to run on the free keyless Pollinations
# fallback provider. The key is server-side only — never exposed to the browser.
APIKEY_FAN_BASE_URL=https://apikey.fan/v1
APIKEY_FAN_API_KEY=

# --- Logging ---
# debug | info | warn | error
LOG_LEVEL=info

# --- Media cache ---
# Where generated media bytes are cached (server-side, content-addressed).
MEDIA_CACHE_DIR=.media-cache
